{
  "name": "Jonas Review Guesser",
  "version": "2.2.0",
  "manifest_version": 3,
  "description": "Guess Steam review counts, score your accuracy, and build streaks.",
  "action": {
    "default_title": "Jonas Review Guesser",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://store.steampowered.com/app/*"
      ],
      "js": [
        "src/siteRules.js",
        "src/utils.js",
        "src/storage.js",
        "src/pageDetection.js",
        "src/reviewCounts.js",
        "src/guessingGame.js",
        "src/nextGame.js",
        "src/main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "web_accessible_resources": [
    {
      "resources": [
        "data/released_appids.csv",
        "data/Batch_1.csv",
        "data/Batch_2.csv",
        "data/Batch_3.csv",
        "data/Batch_4.csv",
        "data/Batch_5.csv",
        "data/Batch_6.csv"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
